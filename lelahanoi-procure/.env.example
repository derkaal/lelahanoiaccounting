# Copy to .env (gitignored) and fill in. Only names are documented here, never values.

# --- Supabase (bookkeeping + inventory catalog, same project) ---
# Direct Postgres connection string from Supabase → Project Settings → Database.
# Preferred for schema inspection and for the price_observations writes.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# REST fallback (used only if SUPABASE_DB_URL is not set).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (one provider active at a time; see config/procure.yaml in Phase 1) ---
PROCURE_LLM_PROVIDER=anthropic            # anthropic | kimi | none
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=                          # for Kimi K2

# --- Phase 2 endpoint ---
PROCURE_SHARED_SECRET=
